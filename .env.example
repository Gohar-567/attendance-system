# Copy to .env.local for local dev. Set the same values in Vercel project settings.
# Do NOT commit .env.local. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Slack ----
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ATTENDANCE_CHANNEL_ID=
# Email shown in the "you're not in the system" DM the bot sends to
# unknown Slack users. Set to your HR contact's email.
HR_NOTIFY_EMAIL=

# ---- Anthropic ----
# (Skipped — parser is regex-only. Var kept for future use.)
ANTHROPIC_API_KEY=

# ---- Cron (Vercel cron secret, Phase 6) ----
CRON_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
